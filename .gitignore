/.gradle/
/**/build/
local.properties

# Android signing material and local credentials must never enter Git.
*.jks
*.keystore
*.p12
*.pfx
key.properties
secrets.properties
.env
.env.*

# Build outputs are distributed through GitHub Actions artifacts.
*.apk
*.aab

# Wrangler local state and Cloudflare development secrets.
.wrangler/
.dev.vars
.dev.vars.*

# Additional private key and encoded secret material.
*.pem
*.key
*.base64

# Cloud service-account and OAuth client-secret exports.
service-account*.json
*-service-account*.json
firebase-adminsdk*.json
client_secret*.json

# Firebase local state and debug output.
.firebase/
firebase-debug.log
firebase-debug.*.log
