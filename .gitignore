# Gradle / Android build output
/.gradle/
/**/build/
local.properties
coverage/
**/coverage/
*.log

# Android signing material and local credentials must never enter Git.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.base64
*.asc
*.gpg
*.mobileprovision
key.properties
secrets.properties
.env
.env.*
.envrc
.netrc
.npmrc

# Build outputs are distributed through GitHub Actions artifacts.
*.apk
*.aab

# Wrangler local state and Cloudflare development secrets.
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*
.wrangler-dry-run/
**/.wrangler-dry-run/

# Local package caches and dependencies.
node_modules/
**/node_modules/
.npm/
.npmrc

# Cloud service-account and OAuth client-secret exports.
service-account*.json
*-service-account*.json
firebase-adminsdk*.json
client_secret*.json

# Firebase local state and debug output.
.firebase/
firebase-debug.log
firebase-debug.*.log
