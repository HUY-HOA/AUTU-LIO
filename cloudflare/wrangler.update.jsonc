{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autu-lio-updates",
  "main": "update-worker.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
