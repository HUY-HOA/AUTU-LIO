{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autu-lio",
  "main": "./website-worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
