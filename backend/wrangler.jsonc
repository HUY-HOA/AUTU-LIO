{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autu-lio-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "GOOGLE_WEB_CLIENT_ID": "SET_GOOGLE_WEB_CLIENT_ID",
    "ALLOWED_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autu-lio-production",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
